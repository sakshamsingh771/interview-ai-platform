# Postgres
POSTGRES_USER=interview_user
POSTGRES_PASSWORD=interview_pass
POSTGRES_DB=interview_ai
DATABASE_URL=postgresql+asyncpg://interview_user:interview_pass@db:5432/interview_ai

# Auth
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# SMTP (optional - leave SMTP_HOST empty to log emails instead of sending them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PrepRoom <no-reply@preproom.local>
CONTACT_RECEIVER_EMAIL=

# AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: if set, question generation tries OpenAI first, then falls back
# to Anthropic (above), then to the built-in offline question bank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Sign-In (get a Client ID from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# GitHub Sign-In (create an OAuth App at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
